{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LanguageCenter.Api (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/LanguageCenter.Api/bin/Debug/net10.0/LanguageCenter.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/LanguageCenter.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "LanguageCenter.WinForms",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/winforms/LanguageCenter.WinForms/bin/Debug/net10.0-windows/LanguageCenter.WinForms.dll",
      "args": [],
      "cwd": "${workspaceFolder}/winforms/LanguageCenter.WinForms",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
