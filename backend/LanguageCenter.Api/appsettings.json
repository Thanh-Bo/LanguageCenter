{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },

  // Jwt:Key CỐ Ý KHÔNG có ở đây — signing key phải nằm trong User Secrets
  // (Development) hoặc biến môi trường Jwt__Key (Production). Không commit secret.
  "Jwt": {
    "Issuer": "LanguageCenter.Api",
    "Audience": "LanguageCenter.Clients",
    "AccessTokenExpirationMinutes": 60
  }
}
